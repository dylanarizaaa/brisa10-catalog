# Credenciales públicas de Supabase (Settings → API). Es el mismo proyecto de la app administrativa.
# NUNCA colocar aquí la clave service_role: todo lo que empieza por PUBLIC_ llega al navegador.
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# WhatsApp Business del negocio: indicativo del país + número, solo dígitos (57 = Colombia).
PUBLIC_WHATSAPP_NUMBER=573001234567

# Dirección pública del sitio, sin barra final (enlaces canónicos y Open Graph).
PUBLIC_SITE_URL=https://www.tu-dominio.com
