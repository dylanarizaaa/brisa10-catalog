---
import '@/styles/global.css'
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url'
import instrumentSerif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url'
import AnnouncementBar from '@/components/layout/AnnouncementBar.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import WhatsAppFab from '@/components/layout/WhatsAppFab.astro'
import { site } from '@/config/site'
import { getBusiness } from '@/services/supabase/business'
import { getCategories } from '@/services/supabase/categories'
import { supabaseOrigin } from '@/services/supabase/client'
import type { Category } from '@/types/category'

interface Props {
  /** Título de la página; se le agrega el nombre del negocio. Sin él se usa nombre + lema. */
  title?: string
  description?: string
  /** URL absoluta de la imagen para compartir en redes. */
  image?: string
  /** Ruta canónica (con sus parámetros) cuando no es simplemente la ruta actual. */
  canonicalPath?: string
  ogType?: 'website' | 'product'
  /** Páginas que no deben indexarse (búsquedas, páginas de error). */
  noindex?: boolean
  /** Oculta el botón flotante de WhatsApp (carrito y pedido: taparía los totales). */
  hideWhatsAppFab?: boolean
  /** Categorías ya consultadas por la página (evita repetir la consulta para el menú). */
  categories?: Category[]
}

// Menú y pie muestran las categorías; si la consulta falla, se muestran sin ellas.
const [business, categories] = await Promise.all([
  getBusiness(),
  Astro.props.categories ??
    getCategories().catch((error) => {
      console.error('[menú] categorías:', error)
      return []
    }),
])
const name = business.business_name
const { title, description = site.description, image, canonicalPath, ogType = 'website', noindex = false, hideWhatsAppFab = false } = Astro.props
const fullTitle = title ? `${title} · ${name}` : `${name} · ${site.tagline}`
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
// Sin imagen propia (inicio, catálogo) se comparte la imagen general del sitio.
const ogImage = image ?? new URL('/og-default.png', Astro.site).href
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title ?? name} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Las dos fuentes del primer pantallazo se piden de inmediato; las fotos vienen de Supabase. -->
    <link rel="preload" as="font" type="font/woff2" href={instrumentSerif} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSans} crossorigin />
    {supabaseOrigin && <link rel="preconnect" href={supabaseOrigin} />}
    <slot name="head" />
    <!-- Activa las apariciones al hacer scroll solo si el navegador puede mostrarlas después. -->
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-on')
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-[2px] focus:bg-ink focus:px-4 focus:py-2 focus:text-white">
      Saltar al contenido
    </a>
    <AnnouncementBar />
    <Header businessName={name} categories={categories} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer business={business} categories={categories} />
    {!hideWhatsAppFab && <WhatsAppFab businessName={name} />}
    <!-- Anuncios para lectores de pantalla (p. ej. "agregado al carrito"). -->
    <p id="live-region" class="sr-only" role="status" aria-live="polite"></p>

    <script>
      import { addToCart } from '@/lib/cart'

      // Apariciones al hacer scroll.
      const pending = document.querySelectorAll<HTMLElement>('[data-reveal]')
      if (document.documentElement.classList.contains('reveal-on')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // También se muestra lo que quedó arriba de la pantalla (saltos a un ancla, scroll muy rápido).
              if (!entry.isIntersecting && entry.boundingClientRect.top >= 0) continue
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        )
        pending.forEach((element) => observer.observe(element))
      }

      // Botón "agregar" de las tarjetas de producto (un solo listener para toda la página).
      const live = document.getElementById('live-region')
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-quick-add]')
        if (!button) return
        event.preventDefault()
        const product = JSON.parse(button.dataset.quickAdd ?? '{}')
        const total = addToCart(product, 1)
        if (live) {
          live.textContent =
            total > 0
              ? `${product.name} agregado al carrito. Llevas ${total}.`
              : 'Tu carrito ya tiene el máximo de productos distintos.'
        }
        if (total === 0) return
        button.dataset.added = 'true'
        window.setTimeout(() => delete button.dataset.added, 1600)
      })
    </script>
  </body>
</html>
