---
import '@/styles/global.css'
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url'
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import WhatsAppFab from '@/components/layout/WhatsAppFab.astro'
import { site } from '@/config/site'
import { getBusiness } from '@/services/supabase/business'
import { supabaseOrigin } from '@/services/supabase/client'

interface Props {
  /** Título de la página; se le agrega el nombre del negocio. Sin él se usa nombre + lema. */
  title?: string
  description?: string
  /** URL absoluta de la imagen para compartir en redes. */
  image?: string
  /** Ruta canónica (con sus parámetros) cuando no es simplemente la ruta actual. */
  canonicalPath?: string
  ogType?: 'website' | 'product'
  /** Páginas que no deben indexarse (búsquedas, páginas de error). */
  noindex?: boolean
  /** Oculta el botón flotante de WhatsApp (carrito y pedido: taparía los totales). */
  hideWhatsAppFab?: boolean
}

const business = await getBusiness()
const name = business.business_name
const { title, description = site.description, image, canonicalPath, ogType = 'website', noindex = false, hideWhatsAppFab = false } = Astro.props
const fullTitle = title ? `${title} · ${name}` : `${name} · ${site.tagline}`
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
// Sin imagen propia (inicio, catálogo) se comparte la imagen general del sitio.
const ogImage = image ?? new URL('/og-default.png', Astro.site).href
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf6f0" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title ?? name} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Las dos fuentes del primer pantallazo se piden de inmediato; las fotos vienen de Supabase. -->
    <link rel="preload" as="font" type="font/woff2" href={fraunces} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSans} crossorigin />
    {supabaseOrigin && <link rel="preconnect" href={supabaseOrigin} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-cream">
      Saltar al contenido
    </a>
    <Header businessName={name} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer business={business} />
    {!hideWhatsAppFab && <WhatsAppFab businessName={name} />}
  </body>
</html>
