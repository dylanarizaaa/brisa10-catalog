---
import { OrderForm } from '@/components/checkout/OrderForm'
import MainLayout from '@/layouts/MainLayout.astro'
import { getBusiness } from '@/services/supabase/business'

const business = await getBusiness()
---

<MainLayout title="Tu pedido" description="Completa tus datos y envía tu solicitud de pedido por WhatsApp." noindex hideWhatsAppFab>
  <div class="container-page pt-8 pb-4 sm:pt-12">
    <nav aria-label="Ruta de navegación" class="mb-4 text-sm text-stone">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-ink hover:underline">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/carrito" class="hover:text-ink hover:underline">Carrito</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-ink">Pedido</li>
      </ol>
    </nav>
    <h1 class="text-4xl sm:text-5xl">Tu pedido</h1>
  </div>
  <div class="container-page py-6 lg:py-10">
    <!-- El carrito vive en el navegador (localStorage): esta parte se pinta en el cliente. -->
    <OrderForm client:only="react" businessName={business.business_name}>
      <p slot="fallback" class="py-16 text-center text-stone">Cargando…</p>
    </OrderForm>
    <noscript>
      <p class="rounded-2xl bg-clay-soft px-4 py-3 text-sm text-clay-deep">Para usar el carrito necesitas activar JavaScript en tu navegador. También puedes escribirnos por WhatsApp.</p>
    </noscript>
  </div>
</MainLayout>
