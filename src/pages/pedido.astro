---
import { OrderForm } from '@/components/checkout/OrderForm'
import PageHeader from '@/components/common/PageHeader.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import { getBusiness } from '@/services/supabase/business'

const business = await getBusiness()
---

<MainLayout title="Tu pedido" description="Completa tus datos y envía tu solicitud de pedido por WhatsApp." noindex hideWhatsAppFab>
  <PageHeader
    title="Tu pedido"
    description="Cuéntanos a nombre de quién va y cómo quieres recibirlo."
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Carrito', href: '/carrito' }, { label: 'Pedido' }]}
  />
  <div class="container-page min-h-[75svh] pb-4">
    <!-- El carrito vive en el navegador (localStorage): esta parte se pinta en el cliente. -->
    <OrderForm client:only="react" businessName={business.business_name}>
      <p slot="fallback" class="py-16 text-center text-stone">Cargando…</p>
    </OrderForm>
    <noscript>
      <p class="rounded-[2px] bg-clay-soft px-4 py-3 text-sm text-clay-deep">Para usar el carrito necesitas activar JavaScript en tu navegador. También puedes escribirnos por WhatsApp.</p>
    </noscript>
  </div>
</MainLayout>
