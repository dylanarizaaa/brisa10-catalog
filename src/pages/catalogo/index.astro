---
import { PackageSearch, TriangleAlert, X } from '@lucide/astro'
import EmptyState from '@/components/common/EmptyState.astro'
import PageHeader from '@/components/common/PageHeader.astro'
import { CatalogToolbar } from '@/components/products/CatalogToolbar'
import CategoryChips from '@/components/products/CategoryChips.astro'
import Pagination from '@/components/products/Pagination.astro'
import ProductGrid from '@/components/products/ProductGrid.astro'
import { buttonVariants } from '@/components/ui/button'
import MainLayout from '@/layouts/MainLayout.astro'
import { CATALOG_PAGE_SIZE, catalogUrl, parseCatalogParams } from '@/lib/catalogUrl'
import { getCategories } from '@/services/supabase/categories'
import { getCatalog } from '@/services/supabase/products'
import type { Category } from '@/types/category'
import type { CatalogPage } from '@/types/product'

const params = parseCatalogParams(Astro.url.searchParams)

let categories: Category[] = []
let page: CatalogPage | null = null
try {
  ;[categories, page] = await Promise.all([
    getCategories().catch((error) => {
      console.error('[catálogo] categorías:', error)
      return []
    }),
    getCatalog({
      search: params.q || undefined,
      categorySlug: params.categoria || undefined,
      sort: params.orden,
      limit: CATALOG_PAGE_SIZE,
      offset: (params.pagina - 1) * CATALOG_PAGE_SIZE,
    }),
  ])
} catch (error) {
  console.error('[catálogo] productos:', error)
  // Un error no debe quedar guardado en la caché del CDN.
  Astro.cache.set(false)
  Astro.response.status = 503
}

const category = categories.find((item) => item.slug === params.categoria)
const total = page?.total ?? 0
const pageCount = Math.max(1, Math.ceil(total / CATALOG_PAGE_SIZE))
const hasFilters = Boolean(params.q || params.categoria)
const heading = category?.name ?? 'Catálogo'
const title = params.q ? `Resultados para "${params.q}"` : category ? `${category.name}` : 'Catálogo'
const description = category
  ? `${category.name}: ${category.product_count} ${category.product_count === 1 ? 'producto' : 'productos'} disponibles en nuestra tienda de Bogotá. Haz tu pedido por WhatsApp.`
  : 'Explora todos nuestros productos de decoración, cerámicas, peluches y regalos. Haz tu pedido por WhatsApp.'
const intro = category
  ? `Todo lo que tenemos en ${category.name.toLowerCase()}, listo para pedir por WhatsApp.`
  : 'Decoración, cerámicas, peluches y regalos. Elige lo que te guste y pídelo por WhatsApp.'
---

<MainLayout
  categories={categories}
  title={title}
  description={description}
  canonicalPath={catalogUrl({ categoria: category?.slug, pagina: params.pagina })}
  noindex={Boolean(params.q) || !page}
>
  <PageHeader
    title={heading}
    description={intro}
    crumbs={category
      ? [{ label: 'Inicio', href: '/' }, { label: 'Catálogo', href: '/catalogo' }, { label: category.name }]
      : [{ label: 'Inicio', href: '/' }, { label: 'Catálogo' }]}
  />

  <div class="container-page flex flex-col gap-10">
    <CategoryChips params={params} categories={categories} />
    <div class="border-y border-linen py-4">
      <CatalogToolbar client:load params={params} />
    </div>
  </div>

  <section aria-labelledby="catalog-results" class="container-page pt-6 sm:pt-8">
    <h2 id="catalog-results" class="sr-only">Productos</h2>
    {!page ? (
      <EmptyState title="No pudimos cargar el catálogo" text="Puede ser un problema temporal de conexión. Inténtalo de nuevo en un momento.">
        <TriangleAlert slot="icon" class="size-8" stroke-width={1.5} />
        <a href={Astro.url.pathname + Astro.url.search} class={buttonVariants()}>Reintentar</a>
      </EmptyState>
    ) : (
      <>
        <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="text-sm text-stone" aria-live="polite">
            {total === 0 ? 'Sin resultados' : `${total} ${total === 1 ? 'producto' : 'productos'}`}
            {params.q && (
              <>
                {' '}para <span class="font-medium text-ink">"{params.q}"</span>
              </>
            )}
          </p>
          {hasFilters && (
            <a href={catalogUrl({ orden: params.orden })} class="inline-flex min-h-9 items-center gap-1 text-sm font-medium text-clay hover:text-clay-deep">
              <X class="size-4" />
              Quitar filtros
            </a>
          )}
        </div>

        {page.items.length > 0 ? (
          <>
            <ProductGrid products={page.items} eagerCount={4} />
            <Pagination params={params} pageCount={pageCount} />
          </>
        ) : total > 0 ? (
          <EmptyState title="Esta página no tiene productos">
            <PackageSearch slot="icon" class="size-8" stroke-width={1.5} />
            <a href={catalogUrl({ ...params, pagina: 1 })} class={buttonVariants()}>Ir a la primera página</a>
          </EmptyState>
        ) : hasFilters ? (
          <EmptyState title="No encontramos productos" text="Prueba con otra palabra o revisa otra categoría.">
            <PackageSearch slot="icon" class="size-8" stroke-width={1.5} />
            <a href="/catalogo" class={buttonVariants()}>Ver todo el catálogo</a>
          </EmptyState>
        ) : (
          <EmptyState title="Pronto habrá productos aquí" text="Estamos preparando el catálogo. Mientras tanto, escríbenos por WhatsApp.">
            <PackageSearch slot="icon" class="size-8" stroke-width={1.5} />
          </EmptyState>
        )}
      </>
    )}
  </section>
</MainLayout>
