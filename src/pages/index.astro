---
import About from '@/components/home/About.astro'
import Benefits from '@/components/home/Benefits.astro'
import CategoryGrid from '@/components/home/CategoryGrid.astro'
import Hero from '@/components/home/Hero.astro'
import Marquee from '@/components/home/Marquee.astro'
import ProductSection from '@/components/home/ProductSection.astro'
import ShippingInfo from '@/components/home/ShippingInfo.astro'
import SocialBand from '@/components/home/SocialBand.astro'
import { site } from '@/config/site'
import MainLayout from '@/layouts/MainLayout.astro'
import { getBusiness } from '@/services/supabase/business'
import { getCategories } from '@/services/supabase/categories'
import { getCatalog } from '@/services/supabase/products'

// Si una consulta falla, su sección no se muestra y el resto de la página sigue en pie.
async function orEmpty<T>(label: string, promise: Promise<T[]>): Promise<T[]> {
  try {
    return await promise
  } catch (error) {
    console.error(`[inicio] ${label}:`, error)
    // Una página incompleta por un error no debe quedar guardada en la caché del CDN.
    Astro.cache.set(false)
    return []
  }
}

const [business, categories, featured, recent] = await Promise.all([
  getBusiness(),
  orEmpty('categorías', getCategories()),
  orEmpty('destacados', getCatalog({ featured: true, limit: 4 }).then((page) => page.items)),
  orEmpty('recientes', getCatalog({ sort: 'recientes', limit: 8 }).then((page) => page.items)),
])

// Datos estructurados del negocio para buscadores.
const sameAs = Object.values(site.social).filter((url) => url && new URL(url).pathname.length > 1)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: business.business_name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
  ...(business.phone && { telephone: business.phone }),
  ...(business.email && { email: business.email }),
  address: {
    '@type': 'PostalAddress',
    ...(business.address && { streetAddress: business.address }),
    addressLocality: site.city,
    addressCountry: 'CO',
  },
  ...(sameAs.length > 0 && { sameAs }),
}
---

<MainLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <Hero products={featured.length > 0 ? featured : recent} />
  <Marquee words={categories.map((category) => category.name)} />
  {categories.length > 0 && <CategoryGrid categories={categories} />}
  {featured.length > 0 && (
    <ProductSection eyebrow="Favoritos" title="Productos destacados" products={featured} href="/catalogo" tinted />
  )}
  <About businessName={business.business_name} />
  {recent.length > 0 && (
    <ProductSection eyebrow="Recién llegados" title="Lo más nuevo" products={recent} href="/catalogo?orden=recientes" />
  )}
  <Benefits />
  <ShippingInfo businessName={business.business_name} />
  <SocialBand businessName={business.business_name} />
</MainLayout>
