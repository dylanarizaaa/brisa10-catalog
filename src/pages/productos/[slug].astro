---
import { AddToCart } from '@/components/cart/AddToCart'
import SectionHeading from '@/components/common/SectionHeading.astro'
import SocialIcon from '@/components/common/SocialIcon.astro'
import AvailabilityBadge from '@/components/products/AvailabilityBadge.astro'
import ProductGallery from '@/components/products/ProductGallery.astro'
import ProductGrid from '@/components/products/ProductGrid.astro'
import { ProductInfoAccordion } from '@/components/products/ProductInfoAccordion'
import { buttonVariants } from '@/components/ui/button'
import Sparkle from '@/components/common/Sparkle.astro'
import { site } from '@/config/site'
import MainLayout from '@/layouts/MainLayout.astro'
import { catalogUrl } from '@/lib/catalogUrl'
import { formatCurrency } from '@/lib/formatCurrency'
import { whatsappLink } from '@/lib/whatsapp'
import { productImageUrl } from '@/services/supabase/client'
import { getProduct } from '@/services/supabase/products'
import type { ProductDetail } from '@/types/product'

let product: ProductDetail | null
try {
  product = await getProduct(Astro.params.slug ?? '')
} catch (error) {
  console.error('[producto]', error)
  // Un error no debe quedar guardado en la caché del CDN.
  Astro.cache.set(false)
  return new Response('No pudimos cargar el producto. Inténtalo de nuevo en un momento.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '30' },
  })
}
// No existe, se despublicó o está inactivo.
if (!product) return Astro.rewrite('/404')

const url = new URL(`/productos/${product.slug}`, Astro.site).href
const mainImage = product.images[0] ? productImageUrl(product.images[0]) : undefined
const soldOut = product.availability === 'agotado'
const description =
  product.description?.replace(/\s+/g, ' ').trim().slice(0, 155) ||
  `${product.name} en ${product.category_name}. ${formatCurrency(product.price)}. Pídelo por WhatsApp, con envío en ${site.city}.`
const whatsapp = whatsappLink(
  `Hola, me interesa este producto:\n*${product.name}* (${formatCurrency(product.price)})\n${url}\n¿Está disponible?`,
)

// Datos estructurados: permiten a los buscadores mostrar precio y disponibilidad.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description,
  image: product.images.map(productImageUrl),
  category: product.category_name,
  url,
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'COP',
    price: product.price,
    availability:
      product.availability === 'agotado'
        ? 'https://schema.org/OutOfStock'
        : product.availability === 'ultimas_unidades'
          ? 'https://schema.org/LimitedAvailability'
          : 'https://schema.org/InStock',
  },
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Inicio', path: '/' },
    { name: 'Catálogo', path: '/catalogo' },
    { name: product.category_name, path: catalogUrl({ categoria: product.category_slug }) },
    { name: product.name, path: `/productos/${product.slug}` },
  ].map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, Astro.site).href,
  })),
}
---

<MainLayout title={product.name} description={description} image={mainImage} ogType="product">
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(product.price)} />
    <meta property="product:price:currency" content="COP" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <div class="container-page pt-6 sm:pt-10">
    <nav aria-label="Ruta de navegación" class="mb-6 text-sm text-stone sm:mb-8">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="link-draw hover:text-ink">Inicio</a></li>
        <li aria-hidden="true" class="text-linen">/</li>
        <li><a href="/catalogo" class="link-draw hover:text-ink">Catálogo</a></li>
        <li aria-hidden="true" class="text-linen">/</li>
        <li>
          <a href={catalogUrl({ categoria: product.category_slug })} class="link-draw hover:text-ink">{product.category_name}</a>
        </li>
      </ol>
    </nav>

    <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:gap-12 lg:gap-20">
      <div class="min-w-0 md:sticky md:top-28 md:self-start">
        <ProductGallery images={product.images} productName={product.name} dimmed={soldOut} />
      </div>

      <div class="flex min-w-0 flex-col gap-7">
        <div class="flex flex-col items-start gap-4">
          <a href={catalogUrl({ categoria: product.category_slug })} class="eyebrow hover:text-clay-deep">{product.category_name}</a>
          <h1 class="text-4xl leading-[1.08] sm:text-5xl">{product.name}</h1>
          <div class="flex flex-wrap items-center gap-4">
            <p class="font-display text-3xl sm:text-4xl">{formatCurrency(product.price)}</p>
            <AvailabilityBadge availability={product.availability} />
          </div>
        </div>

        {product.description && (
          <p class="text-[1.0625rem] leading-relaxed whitespace-pre-line text-stone">{product.description}</p>
        )}

        <div class="flex flex-col gap-3 rounded-[1.75rem] border border-linen bg-card p-5 shadow-soft sm:p-6">
          <AddToCart
            client:load
            soldOut={soldOut}
            product={{
              id: product.id,
              slug: product.slug,
              name: product.name,
              price: product.price,
              image: product.main_image_path,
            }}
          />
          {whatsapp && (
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
              <SocialIcon name="whatsapp" class="size-5" />
              {soldOut ? 'Preguntar cuándo vuelve' : 'Consultar por WhatsApp'}
            </a>
          )}
          <p class="flex items-center justify-center gap-2 pt-1 text-center text-xs text-stone">
            <Sparkle class="size-2.5 text-clay" />
            Sin pagos en línea: confirmas tu pedido por WhatsApp
          </p>
        </div>

        <div>
          <h2 class="sr-only">Información de compra</h2>
          <ProductInfoAccordion client:visible />
        </div>
      </div>
    </div>
  </div>

  {product.related.length > 0 && (
    <section class="container-page pt-20 sm:pt-28">
      <SectionHeading
        eyebrow="También te puede gustar"
        title={`Más en ${product.category_name}`}
        href={catalogUrl({ categoria: product.category_slug })}
      />
      <ProductGrid products={product.related} />
    </section>
  )}
</MainLayout>
