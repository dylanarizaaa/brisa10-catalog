---
import { CartView } from '@/components/cart/CartView'
import PageHeader from '@/components/common/PageHeader.astro'
import MainLayout from '@/layouts/MainLayout.astro'

---

<MainLayout title="Tu carrito" description="Revisa los productos de tu pedido antes de enviarlo por WhatsApp." noindex hideWhatsAppFab>
  <PageHeader
    title="Tu carrito"
    description="Revisa tu selección. Verificamos la disponibilidad antes de continuar."
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Carrito' }]}
  />
  <div class="container-page min-h-[75svh] pb-4">
    <!-- El carrito vive en el navegador (localStorage): esta parte se pinta en el cliente. -->
    <CartView client:only="react">
      <p slot="fallback" class="py-16 text-center text-stone">Cargando…</p>
    </CartView>
    <noscript>
      <p class="rounded-[2px] bg-clay-soft px-4 py-3 text-sm text-clay-deep">Para usar el carrito necesitas activar JavaScript en tu navegador. También puedes escribirnos por WhatsApp.</p>
    </noscript>
  </div>
</MainLayout>
