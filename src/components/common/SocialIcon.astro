---
// Iconos de marca (Lucide ya no los incluye). Trazos simples, heredan el color del texto.
interface Props {
  name: 'instagram' | 'tiktok' | 'facebook' | 'whatsapp'
  class?: string
}
const { name, class: className = 'size-5' } = Astro.props
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'tiktok' && (
    <path d="M14 3v11.2a3.8 3.8 0 1 1-3.8-3.8M14 3c.3 2.6 2.1 4.6 5 5" />
  )}
  {name === 'facebook' && (
    <path d="M14 8.5V6.8c0-.9.5-1.3 1.4-1.3H17V2.6c-.5-.1-1.5-.1-2.4-.1C12.200 2.500 10.500 4 10.500 6.600v1.900H8v3.200h2.500V21.500H14v-9.800h2.600l.4-3.200H14Z" />
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M3.200 20.800l1.300-4.600A8.800 8.800 0 1 1 8 19.500l-4.800 1.300Z" />
      <path d="M9 8.300c-.4.900-.2 2.300 1.100 3.900 1.400 1.700 3 2.500 4.100 2.400.7-.1 1.200-.7 1.400-1.300l-1.700-1-.8.800c-.8-.3-1.800-1.300-2.200-2.200l.7-.8-.9-1.800c-.7-.1-1.400.300-1.700 1Z" />
    </>
  )}
</svg>
