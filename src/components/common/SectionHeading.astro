---
import { ArrowRight } from '@lucide/astro'

interface Props {
  eyebrow?: string
  title: string
  /** Enlace "ver todo" a la derecha del título. */
  href?: string
  linkLabel?: string
}
const { eyebrow, title, href, linkLabel = 'Ver todo' } = Astro.props
---

<div class="mb-9 flex items-end justify-between gap-6 sm:mb-12" data-reveal>
  <div class="flex flex-col gap-3">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-[2rem] leading-tight sm:text-5xl">{title}</h2>
  </div>
  {href && (
    <a href={href} class="group inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-medium text-ink">
      <span class="link-draw hidden sm:inline">{linkLabel}</span>
      <span class="grid size-10 place-items-center rounded-full border border-ink/25 transition-colors duration-200 group-hover:border-clay group-hover:bg-clay group-hover:text-white">
        <ArrowRight class="size-4" />
      </span>
      <span class="sr-only sm:hidden">{linkLabel}</span>
    </a>
  )}
</div>
