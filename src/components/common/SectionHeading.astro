---
import { ArrowRight } from '@lucide/astro'

interface Props {
  eyebrow?: string
  title: string
  /** Enlace "ver todo" a la derecha del título. */
  href?: string
  linkLabel?: string
}
const { eyebrow, title, href, linkLabel = 'Ver todo' } = Astro.props
---

<div class="mb-8 flex items-end justify-between gap-6 sm:mb-10">
  <div class="flex flex-col gap-2">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-3xl sm:text-4xl">{title}</h2>
  </div>
  {href && (
    <a href={href} class="group inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-medium text-clay hover:text-clay-deep">
      {linkLabel}
      <ArrowRight class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
  )}
</div>
