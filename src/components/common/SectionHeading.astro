---
import { ArrowRight } from '@lucide/astro'

interface Props {
  eyebrow?: string
  title: string
  /** Enlace "ver todo" a la derecha del título. */
  href?: string
  linkLabel?: string
  align?: 'left' | 'center'
  /** Para enlazar el título con su sección (aria-labelledby). */
  id?: string
}
const { eyebrow, title, href, linkLabel = 'Ver todo', align = 'left', id } = Astro.props
---

{align === 'center' ? (
  <div class="mb-10 flex flex-col items-center gap-3 text-center sm:mb-14" data-reveal>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="text-[2.5rem] leading-[1.02] sm:text-[3.5rem]">{title}</h2>
    {href && (
      <a href={href} class="group mt-2 inline-flex items-center gap-2 text-sm font-medium">
        <span class="link-underline">{linkLabel}</span>
        <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={1.5} />
      </a>
    )}
  </div>
) : (
  <div class="mb-9 flex items-end justify-between gap-6 sm:mb-12" data-reveal>
    <div class="flex flex-col gap-3">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id} class="text-[2.5rem] leading-[1.02] sm:text-[3.5rem]">{title}</h2>
    </div>
    {href && (
      <a href={href} class="group mb-1.5 inline-flex shrink-0 items-center gap-2 text-sm font-medium">
        <span class="link-underline">{linkLabel}</span>
        <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={1.5} />
      </a>
    )}
  </div>
)}
