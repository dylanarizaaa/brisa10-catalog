---
interface Crumb {
  label: string
  href?: string
}
interface Props {
  title: string
  description?: string
  crumbs: Crumb[]
}
const { title, description, crumbs } = Astro.props
---

<!-- Cabecera de página: ruta de navegación, título editorial y una línea de contexto. -->
<div class="container-page flex flex-col items-center pt-10 pb-10 text-center sm:pt-14 sm:pb-14">
  <nav aria-label="Ruta de navegación" class="animate-rise text-xs tracking-[0.08em] text-stone">
    <ol class="flex flex-wrap items-center justify-center gap-2">
      {crumbs.map((crumb, index) => (
        <>
          {index > 0 && <li aria-hidden="true" class="text-linen">/</li>}
          {crumb.href ? (
            <li><a href={crumb.href} class="link-draw hover:text-ink">{crumb.label}</a></li>
          ) : (
            <li aria-current="page" class="text-ink">{crumb.label}</li>
          )}
        </>
      ))}
    </ol>
  </nav>
  <h1 class="mt-5 text-[3rem] leading-[0.98] sm:text-[4.5rem]">{title}</h1>
  {description && (
    <p class="mt-4 max-w-xl animate-rise leading-relaxed text-stone [animation-delay:160ms]">{description}</p>
  )}
</div>
