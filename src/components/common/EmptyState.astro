---
// Mensaje centrado para estados vacíos o de error.
interface Props {
  title: string
  text?: string
}
const { title, text } = Astro.props
---

<div class="flex flex-col items-center gap-5 border-y border-linen px-6 py-20 text-center sm:py-24">
  <span class="grid size-16 place-items-center rounded-full bg-sand text-ink">
    <slot name="icon" />
  </span>
  <h2 class="text-[2.25rem] leading-tight">{title}</h2>
  {text && <p class="max-w-sm leading-relaxed text-stone">{text}</p>}
  <div class="flex flex-wrap justify-center gap-3 empty:hidden"><slot /></div>
</div>
