---
import type { ProductCard as Product } from '@/types/product'
import ProductCard from './ProductCard.astro'

interface Props {
  products: Product[]
  /** Cuántas fotos iniciales se cargan sin esperar (las que se ven al abrir la página). */
  eagerCount?: number
  /** Columnas en escritorio: 4 a página completa, 3 cuando hay filtros laterales. */
  columns?: 3 | 4
  /** Las tarjetas aparecen de forma escalonada al hacer scroll (secciones del inicio). */
  reveal?: boolean
}
const { products, eagerCount = 0, columns = 4, reveal = false } = Astro.props
---

<ul class:list={['grid grid-cols-2 gap-x-4 gap-y-9 sm:gap-x-6 sm:gap-y-12 md:grid-cols-3', columns === 4 ? 'lg:grid-cols-4' : 'xl:grid-cols-3']}>
  {products.map((product, index) => (
    <li data-reveal={reveal ? '' : undefined} style={reveal ? `--reveal-delay:${(index % 4) * 70}ms` : undefined}>
      <ProductCard product={product} eager={index < eagerCount} />
    </li>
  ))}
</ul>
