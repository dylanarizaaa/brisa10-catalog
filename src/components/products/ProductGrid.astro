---
import type { ProductCard as Product } from '@/types/product'
import ProductCard from './ProductCard.astro'

interface Props {
  products: Product[]
  /** Cuántas fotos iniciales se cargan sin esperar (las que se ven al abrir la página). */
  eagerCount?: number
}
const { products, eagerCount = 0 } = Astro.props
---

<ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 sm:gap-y-10 md:grid-cols-3 lg:grid-cols-4">
  {products.map((product, index) => (
    <li>
      <ProductCard product={product} eager={index < eagerCount} />
    </li>
  ))}
</ul>
