---
import { ChevronLeft, ChevronRight } from '@lucide/astro'
import { buttonVariants } from '@/components/ui/button'
import { catalogUrl, type CatalogParams } from '@/lib/catalogUrl'

interface Props {
  params: CatalogParams
  pageCount: number
}
const { params, pageCount } = Astro.props
const page = params.pagina
// Hasta cinco números alrededor de la página actual.
const first = Math.max(1, Math.min(page - 2, pageCount - 4))
const pages = Array.from({ length: Math.min(5, pageCount) }, (_, index) => first + index)
const url = (pagina: number) => catalogUrl({ ...params, pagina })
---

{pageCount > 1 && (
  <nav aria-label="Páginas del catálogo" class="mt-14 flex items-center justify-center gap-2">
    {page > 1 && (
      <a href={url(page - 1)} rel="prev" class={buttonVariants({ variant: 'outline', size: 'icon' })} aria-label="Página anterior">
        <ChevronLeft class="size-4" />
      </a>
    )}
    <ul class="flex items-center gap-1">
      {pages.map((number) => (
        <li>
          <a
            href={url(number)}
            aria-current={number === page ? 'page' : undefined}
            aria-label={`Página ${number}`}
            class={buttonVariants({ variant: number === page ? 'dark' : 'ghost', size: 'icon' })}
          >
            {number}
          </a>
        </li>
      ))}
    </ul>
    {page < pageCount && (
      <a href={url(page + 1)} rel="next" class:list={[buttonVariants({ variant: 'outline' }), 'pr-4']}>
        Siguiente
        <ChevronRight class="size-4" />
      </a>
    )}
  </nav>
)}
