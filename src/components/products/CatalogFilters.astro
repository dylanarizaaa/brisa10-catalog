---
import { Search } from '@lucide/astro'
import { catalogUrl, sortOptions, type CatalogParams } from '@/lib/catalogUrl'
import type { Category } from '@/types/category'

interface Props {
  params: CatalogParams
  categories: Category[]
}
const { params, categories } = Astro.props
// Cambiar de categoría conserva la búsqueda y el orden, y vuelve a la primera página.
const categoryUrl = (slug: string) => catalogUrl({ q: params.q, orden: params.orden, categoria: slug })
const chip =
  'inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border px-4 text-sm whitespace-nowrap transition-colors lg:min-h-10 lg:w-full lg:justify-between lg:border-transparent lg:px-3'
const chipOn = 'border-ink bg-ink text-cream lg:border-ink'
const chipOff = 'border-linen text-ink hover:border-ink lg:hover:border-transparent lg:hover:bg-sand'
---

<div class="flex flex-col gap-5 lg:gap-8">
  <!-- Formulario GET: buscar y ordenar funcionan sin JavaScript y la URL se puede compartir. -->
  <form id="catalog-form" action="/catalogo" method="get" role="search" class="flex flex-col gap-3">
    {params.categoria && <input type="hidden" name="categoria" value={params.categoria} />}
    <div class="relative">
      <label for="catalog-search" class="sr-only">Buscar productos</label>
      <input
        id="catalog-search"
        type="search"
        name="q"
        value={params.q}
        maxlength="80"
        placeholder="Buscar productos…"
        autocomplete="off"
        enterkeyhint="search"
        class="h-12 w-full rounded-full border border-linen bg-white/70 pr-12 pl-5 text-base placeholder:text-stone focus:border-ink focus:outline-none"
      />
      <button type="submit" class="absolute top-0.5 right-0.5 grid size-11 place-items-center rounded-full text-stone hover:text-ink" aria-label="Buscar">
        <Search class="size-5" />
      </button>
    </div>
    <div class="flex items-center gap-2">
      <label for="catalog-sort" class="shrink-0 text-sm text-stone">Ordenar por</label>
      <select
        id="catalog-sort"
        name="orden"
        class="h-11 min-w-0 flex-1 rounded-full border border-linen bg-white/70 px-4 text-sm focus:border-ink focus:outline-none"
      >
        {sortOptions.map((option) => (
          <option value={option.value} selected={option.value === params.orden}>{option.label}</option>
        ))}
      </select>
      <noscript><button type="submit" class="btn btn-outline">Aplicar</button></noscript>
    </div>
  </form>

  {categories.length > 0 && (
    <nav aria-label="Categorías">
      <h2 class="mb-3 hidden font-sans text-xs font-semibold tracking-[0.16em] text-stone uppercase lg:block">Categorías</h2>
      <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:px-0 lg:flex-col lg:gap-1">
        <li>
          <a href={categoryUrl('')} aria-current={params.categoria ? undefined : 'true'} class:list={[chip, params.categoria ? chipOff : chipOn]}>
            Todo
          </a>
        </li>
        {categories.map((category) => {
          const active = category.slug === params.categoria
          return (
            <li>
              <a href={categoryUrl(category.slug)} aria-current={active ? 'true' : undefined} class:list={[chip, active ? chipOn : chipOff]}>
                {category.name}
                <span class:list={['text-xs', active ? 'text-cream/70' : 'text-stone']}>{category.product_count}</span>
              </a>
            </li>
          )
        })}
      </ul>
    </nav>
  )}
</div>

<script>
  const form = document.getElementById('catalog-form') as HTMLFormElement | null
  const sort = document.getElementById('catalog-sort') as HTMLSelectElement | null
  const search = document.getElementById('catalog-search') as HTMLInputElement | null
  if (form && sort && search) {
    // Los campos con su valor por defecto no viajan: la URL queda limpia.
    const clean = () => {
      search.disabled = search.value.trim() === ''
      sort.disabled = sort.value === 'recientes'
    }
    form.addEventListener('submit', clean)
    sort.addEventListener('change', () => {
      clean()
      form.submit()
    })
    // Al volver con el botón "atrás" los campos no deben quedar deshabilitados.
    window.addEventListener('pageshow', () => {
      search.disabled = false
      sort.disabled = false
    })
  }
</script>
