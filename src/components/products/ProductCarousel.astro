---
import Carousel from '@/components/common/Carousel.astro'
import type { ProductCard as Product } from '@/types/product'
import ProductCard from './ProductCard.astro'

interface Props {
  products: Product[]
  label: string
}
const { products, label } = Astro.props
---

<Carousel label={label}>
  {products.map((product, index) => (
    <li
      class="w-[68%] shrink-0 snap-start sm:w-[42%] md:w-[31%] lg:w-[calc((100%-4.5rem)/4)]"
      data-reveal
      style={`--reveal-delay:${Math.min(index, 4) * 80}ms`}
    >
      <ProductCard product={product} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 31vw, 68vw" />
    </li>
  ))}
</Carousel>
