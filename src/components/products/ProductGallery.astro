---
import { ImageOff } from '@lucide/astro'
import { productImageUrl } from '@/services/supabase/client'

interface Props {
  images: string[]
  productName: string
  dimmed?: boolean
}
const { images, productName, dimmed = false } = Astro.props
const many = images.length > 1
---

{images.length === 0 ? (
  <div class="grid aspect-[4/5] place-items-center rounded-[var(--radius-card)] bg-sand text-linen">
    <ImageOff class="size-14" />
    <span class="sr-only">Este producto todavía no tiene fotografías</span>
  </div>
) : (
  <div class="flex flex-col-reverse gap-3 lg:flex-row lg:gap-4" data-gallery>
    {/* En escritorio las miniaturas van a la izquierda; en el celular, debajo. */}
    {many && (
      <ul class="scroll-rail flex shrink-0 gap-2.5 overflow-x-auto p-1 lg:w-22 lg:flex-col lg:overflow-visible">
        {images.map((path, index) => (
          <li class="shrink-0">
            <button
              type="button"
              data-gallery-thumb={index}
              aria-label={`Ver foto ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              class="block h-20 w-16 overflow-hidden rounded-[2px] opacity-55 ring-1 ring-transparent ring-offset-2 ring-offset-paper transition duration-300 aria-[current=true]:opacity-100 aria-[current=true]:ring-ink hover:opacity-100 sm:h-25 sm:w-20"
            >
              <img src={productImageUrl(path)} alt="" width="160" height="160" loading="lazy" decoding="async" class="size-full object-cover" />
            </button>
          </li>
        ))}
      </ul>
    )}
    <div class="relative min-w-0 flex-1">
      <!-- Carrusel con scroll nativo: en el celular se desliza con el dedo, sin JavaScript. -->
      <ul
        class="gallery-track flex snap-x snap-mandatory overflow-x-auto rounded-[var(--radius-card)] bg-sand"
        data-gallery-track
        tabindex={many ? 0 : undefined}
        aria-label={many ? `Fotografías de ${productName}` : undefined}
      >
        {images.map((path, index) => (
          <li class="w-full shrink-0 snap-center" data-gallery-slide>
            <img
              src={productImageUrl(path)}
              alt={many ? `${productName}, foto ${index + 1} de ${images.length}` : productName}
              width="900"
              height="1125"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              class:list={['aspect-[4/5] w-full object-cover', dimmed && 'opacity-70 grayscale-[30%]']}
            />
          </li>
        ))}
      </ul>
      {many && (
        <p class="pointer-events-none absolute right-4 bottom-4 rounded-full bg-paper/90 px-3 py-1 text-xs font-medium text-ink tabular-nums backdrop-blur-sm" aria-hidden="true">
          <span data-gallery-count>1</span> / {images.length}
        </p>
      )}
    </div>
  </div>
)}

<style>
  .gallery-track {
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Las miniaturas desplazan el carrusel; la miniatura activa y el contador siguen a la foto visible.
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]')
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')]
    const count = gallery.querySelector<HTMLElement>('[data-gallery-count]')
    if (!track || thumbs.length === 0) continue

    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        track.scrollTo({ left: index * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' })
      })
    })
    const sync = () => {
      const current = Math.round(track.scrollLeft / track.clientWidth)
      thumbs.forEach((thumb, index) => {
        if (index === current) thumb.setAttribute('aria-current', 'true')
        else thumb.removeAttribute('aria-current')
      })
      if (count) count.textContent = String(current + 1)
    }
    track.addEventListener('scroll', sync, { passive: true })
  }
</script>
