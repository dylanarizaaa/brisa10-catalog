---
import type { Availability } from '@/types/product'

interface Props {
  availability: Availability
  class?: string
}
const { availability, class: className } = Astro.props
const labels: Record<Availability, string> = {
  disponible: 'Disponible',
  ultimas_unidades: 'Últimas unidades',
  agotado: 'Agotado',
}
---

<!-- Disponibilidad en texto discreto con un punto de color (nunca el número exacto de unidades). -->
<span
  class:list={[
    'inline-flex items-center gap-1.5 text-xs font-medium',
    availability === 'disponible' && 'text-sage',
    availability === 'ultimas_unidades' && 'text-clay-deep',
    availability === 'agotado' && 'text-stone',
    className,
  ]}
>
  <span class:list={['size-1.5 rounded-full bg-current', availability === 'ultimas_unidades' && 'animate-pulse']} aria-hidden="true"></span>
  {labels[availability]}
</span>
