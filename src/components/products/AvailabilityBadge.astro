---
import type { Availability } from '@/types/product'

interface Props {
  availability: Availability
  /** Sobre una foto: fondo sólido para que se lea encima de cualquier imagen. */
  onImage?: boolean
}
const { availability, onImage = false } = Astro.props
const labels: Record<Availability, string> = {
  disponible: 'Disponible',
  ultimas_unidades: 'Últimas unidades',
  agotado: 'Agotado',
}
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium',
    onImage && 'shadow-soft',
    availability === 'disponible' && 'bg-sage-soft text-sage',
    availability === 'ultimas_unidades' && (onImage ? 'bg-cream text-clay-deep' : 'bg-clay-soft text-clay-deep'),
    availability === 'agotado' && 'bg-ink text-cream',
  ]}
>
  <span class:list={['size-1.5 rounded-full', availability === 'agotado' ? 'bg-cream/70' : 'bg-current']} aria-hidden="true"></span>
  {labels[availability]}
</span>
