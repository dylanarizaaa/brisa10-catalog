---
import { catalogUrl, type CatalogParams } from '@/lib/catalogUrl'
import type { Category } from '@/types/category'

interface Props {
  params: CatalogParams
  categories: Category[]
}
const { params, categories } = Astro.props
// Cambiar de categoría conserva la búsqueda y el orden, y vuelve a la primera página.
const url = (slug: string) => catalogUrl({ q: params.q, orden: params.orden, categoria: slug })
const chip =
  'inline-flex h-11 shrink-0 items-center gap-2 rounded-full border px-5 text-sm font-medium whitespace-nowrap transition-colors duration-200'
const on = 'border-ink bg-ink text-cream'
const off = 'border-linen bg-card text-ink hover:border-ink'
---

{categories.length > 0 && (
  <nav aria-label="Categorías">
    <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
      <li>
        <a href={url('')} aria-current={params.categoria ? undefined : 'true'} class:list={[chip, params.categoria ? off : on]}>Todo</a>
      </li>
      {categories.map((category) => {
        const active = category.slug === params.categoria
        return (
          <li>
            <a href={url(category.slug)} aria-current={active ? 'true' : undefined} class:list={[chip, active ? on : off]}>
              {category.name}
              <span class:list={['text-xs font-normal', active ? 'text-cream/70' : 'text-stone']}>{category.product_count}</span>
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}
