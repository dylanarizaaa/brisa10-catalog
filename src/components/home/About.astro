---
import { ArrowRight } from '@lucide/astro'
import { buttonVariants } from '@/components/ui/button'

interface Props {
  businessName: string
}
const { businessName } = Astro.props
const steps = [
  { title: 'Elige lo que te gusta', text: 'Explora el catálogo y agrega productos a tu carrito.' },
  { title: 'Arma tu pedido', text: 'Cuéntanos si lo recoges en la tienda o te lo llevamos.' },
  { title: 'Confírmalo por WhatsApp', text: 'Te respondemos con disponibilidad, entrega y forma de pago.' },
]
---

<!-- PENDIENTE: ajustar el texto de presentación con la historia real del negocio. -->
<section id="como-comprar" class="bg-cream py-24 sm:py-32" aria-labelledby="sobre-titulo">
  <div class="container-page grid gap-16 lg:grid-cols-[1.1fr_1fr] lg:gap-24">
    <div class="flex flex-col items-start gap-6">
      <p class="eyebrow" data-reveal>Sobre {businessName}</p>
      <h2 id="sobre-titulo" class="text-[2.75rem] leading-[1] sm:text-[4.25rem]" data-reveal style="--reveal-delay:80ms">
        Una tienda de barrio con cosas <em>lindas</em> para tu casa y para regalar
      </h2>
      <p class="max-w-lg text-[1.0625rem] leading-relaxed text-stone" data-reveal style="--reveal-delay:160ms">
        Elegimos cada pieza una por una: cerámicas, peluches, decoración y detalles que se notan. Aquí puedes ver todo
        lo que tenemos en la tienda y pedirlo sin salir de casa.
      </p>
      <a href="/catalogo" class:list={[buttonVariants({ size: 'lg' }), 'group mt-2']} data-reveal style="--reveal-delay:240ms">
        Ver el catálogo
        <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={1.5} />
      </a>
    </div>

    <div class="flex flex-col justify-center">
      <h3 class="eyebrow mb-4 !text-ink">Así de fácil es comprar</h3>
      <ol class="border-t border-ink/15">
        {steps.map((step, index) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-b border-ink/15 py-7" data-reveal style={`--reveal-delay:${index * 100}ms`}>
            <span class="font-display text-[2.5rem] leading-none text-clay italic" aria-hidden="true">0{index + 1}</span>
            <div class="flex flex-col gap-1.5">
              <h4 class="text-[1.625rem] leading-tight">{step.title}</h4>
              <p class="leading-relaxed text-stone">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
