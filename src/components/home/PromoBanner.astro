---
import { ArrowRight } from '@lucide/astro'
import SocialIcon from '@/components/common/SocialIcon.astro'
import { buttonVariants } from '@/components/ui/button'
import { site } from '@/config/site'
import { whatsappLink } from '@/lib/whatsapp'

interface Props {
  businessName: string
  /** Foto de fondo; sin ella el banner es un bloque oscuro. */
  image?: string | null
}
const { businessName, image } = Astro.props
const whatsapp = whatsappLink(`Hola ${businessName}, quiero saber el costo de envío a mi barrio.`)
---

<!-- Banner a todo lo ancho: entregas en Bogotá. Destino del enlace "Envíos" del menú. -->
<section id="envios" class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="envios-titulo">
  {image && (
    <div class="absolute inset-0 -z-10" data-reveal="image">
      <img src={image} alt="" width="1800" height="1000" loading="lazy" decoding="async" class="size-full object-cover" />
      <div class="absolute inset-0 bg-black/55"></div>
    </div>
  )}
  <div class="container-page flex min-h-[32rem] flex-col items-center justify-center gap-6 py-24 text-center sm:min-h-[38rem]">
    <p class="eyebrow !text-white/80" data-reveal>Entregas</p>
    <h2 id="envios-titulo" class="max-w-3xl text-[3rem] leading-[0.98] sm:text-[5rem]" data-reveal style="--reveal-delay:80ms">
      {site.shipping.summary}
    </h2>
    <p class="max-w-xl leading-relaxed text-white/85" data-reveal style="--reveal-delay:160ms">{site.shipping.detail} {site.shipping.pickup}</p>
    <div class="mt-3 flex flex-wrap justify-center gap-3" data-reveal style="--reveal-delay:240ms">
      {whatsapp && (
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: 'light', size: 'lg' })}>
          <SocialIcon name="whatsapp" class="size-5" />
          Consultar el envío
        </a>
      )}
      <a href="#como-comprar" class:list={[buttonVariants({ variant: 'outline-light', size: 'lg' }), 'group']}>
        Cómo comprar
        <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={1.5} />
      </a>
    </div>
  </div>
</section>
