---
import SectionHeading from '@/components/common/SectionHeading.astro'
import ProductGrid from '@/components/products/ProductGrid.astro'
import type { ProductCard } from '@/types/product'

interface Props {
  eyebrow: string
  title: string
  products: ProductCard[]
  href?: string
  tinted?: boolean
}
const { eyebrow, title, products, href = '/catalogo', tinted = false } = Astro.props
---

<section class:list={['py-16 sm:py-24', tinted && 'grain bg-sand/70']}>
  <div class="container-page">
    <SectionHeading eyebrow={eyebrow} title={title} href={href} />
    <ProductGrid products={products} reveal />
  </div>
</section>
