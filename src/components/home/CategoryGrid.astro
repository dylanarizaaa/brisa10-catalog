---
import SectionHeading from '@/components/common/SectionHeading.astro'
import { catalogUrl } from '@/lib/catalogUrl'
import { productImageUrl } from '@/services/supabase/client'
import type { Category } from '@/types/category'

interface Props {
  categories: Category[]
}
const { categories } = Astro.props
// Sin foto, cada categoría toma un tono de la paleta y muestra su inicial.
const tones = ['bg-clay-soft text-clay', 'bg-sage-soft text-sage', 'bg-sand text-stone', 'bg-linen text-ink']
---

<section class="container-page py-16 sm:py-24">
  <SectionHeading eyebrow="Explora" title="Compra por categoría" href="/catalogo" linkLabel="Todo el catálogo" />
  <ul class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-3 sm:mx-0 sm:flex-wrap sm:justify-center sm:gap-7 sm:overflow-visible sm:px-0 lg:gap-9">
    {categories.map((category, index) => (
      <li class="w-[42vw] max-w-52 shrink-0 snap-start sm:w-44 lg:w-52" data-reveal style={`--reveal-delay:${index * 70}ms`}>
        <a href={catalogUrl({ categoria: category.slug })} class="group flex flex-col gap-4">
          <div class:list={['arch relative aspect-[3/4] overflow-hidden transition-shadow duration-300 group-hover:shadow-lift', tones[index % tones.length]]}>
            {category.image_path ? (
              <img
                src={productImageUrl(category.image_path)}
                alt=""
                width="400"
                height="533"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-700 ease-[var(--ease-soft)] group-hover:scale-[1.07]"
              />
            ) : (
              <span class="grid size-full place-items-center font-display text-7xl italic opacity-60" aria-hidden="true">{category.name.charAt(0)}</span>
            )}
          </div>
          <div class="text-center">
            <h3 class="font-display text-xl transition-colors group-hover:text-clay">{category.name}</h3>
            <p class="mt-0.5 text-xs tracking-wide text-stone">
              {category.product_count} {category.product_count === 1 ? 'producto' : 'productos'}
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
