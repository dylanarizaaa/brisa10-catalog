---
import { ArrowUpRight } from '@lucide/astro'
import Carousel from '@/components/common/Carousel.astro'
import SectionHeading from '@/components/common/SectionHeading.astro'
import { catalogUrl } from '@/lib/catalogUrl'
import { productImageSrcset, productImageUrl } from '@/services/supabase/client'
import type { Category } from '@/types/category'

interface Props {
  categories: Category[]
}
const { categories } = Astro.props
---

<section class="container-page pb-24 sm:pb-32" aria-labelledby="categorias-titulo">
  <SectionHeading id="categorias-titulo" eyebrow="Explora" title="Compra por categoría" href="/catalogo" linkLabel="Todo el catálogo" />
  <Carousel label="Categorías">
    {categories.map((category, index) => (
      <li class="w-[72%] shrink-0 snap-start sm:w-[44%] md:w-[31%] lg:w-[calc((100%-4.5rem)/4)]" data-reveal style={`--reveal-delay:${Math.min(index, 4) * 80}ms`}>
        <a href={catalogUrl({ categoria: category.slug })} class="group block">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] bg-sand">
            {category.image_path ? (
              <img
                src={productImageUrl(category.image_path, 800)}
                srcset={productImageSrcset(category.image_path)}
                sizes="(min-width: 1024px) 25vw, 72vw"
                alt=""
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
              />
            ) : (
              <span class="grid size-full place-items-center font-display text-8xl text-ink/15 italic" aria-hidden="true">{category.name.charAt(0)}</span>
            )}
            <span class="absolute top-4 right-4 grid size-10 place-items-center rounded-full bg-paper/90 text-ink opacity-0 transition-all duration-500 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
              <ArrowUpRight class="size-4" stroke-width={1.5} />
            </span>
          </div>
          <div class="flex items-baseline justify-between gap-3 pt-4">
            <h3 class="text-[1.75rem] leading-tight"><span class="link-draw">{category.name}</span></h3>
            <span class="text-xs text-stone">{category.product_count} {category.product_count === 1 ? 'producto' : 'productos'}</span>
          </div>
        </a>
      </li>
    ))}
  </Carousel>
</section>
