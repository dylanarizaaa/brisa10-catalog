---
import Sparkle from '@/components/common/Sparkle.astro'

interface Props {
  /** Palabras de la cinta (p. ej. las categorías). */
  words: string[]
}
const base = Astro.props.words.length > 0 ? Astro.props.words : ['Cerámicas', 'Peluches', 'Decoración', 'Regalos']
// Se repite hasta llenar pantallas anchas; las dos mitades idénticas hacen el bucle continuo.
const half = Array.from({ length: Math.max(2, Math.ceil(12 / base.length)) }, () => base).flat()
---

<div class="overflow-hidden bg-clay py-4 text-cream sm:py-5" aria-hidden="true">
  <div class="flex w-max animate-marquee bg-clay">
    {[...half, ...half].map((word) => (
      <span class="flex items-center gap-8 pr-8 font-display text-2xl italic sm:text-3xl">
        {word}
        <Sparkle class="size-4 text-clay-soft" />
      </span>
    ))}
  </div>
</div>
