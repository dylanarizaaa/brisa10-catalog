---
import { ArrowRight, Pause, Play } from '@lucide/astro'
// Ilustración de respaldo: solo se usa si no hay foto configurada ni productos con foto.
import fallbackImage from '@/assets/hero.svg'
import { buttonVariants } from '@/components/ui/button'
import { site } from '@/config/site'
import { formatCurrency } from '@/lib/formatCurrency'
import { productImageSrcset, productImageUrl } from '@/services/supabase/client'
import type { ProductCard } from '@/types/product'

interface Props {
  /** Producto cuya foto hace de portada mientras no haya video ni foto propia. */
  product?: ProductCard
}
const { product } = Astro.props
const { video, image, alt } = site.hero
const desktopVideo = video.desktop || video.mobile
const hasVideo = Boolean(desktopVideo)
const videoType = (src: string) => (src.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4')
// Prioridad de la imagen: foto propia de la portada > foto de un producto > ilustración.
const productPhoto = !image && product?.main_image_path ? product.main_image_path : null
const poster = image || (productPhoto ? productImageUrl(productPhoto, 1800) : fallbackImage.src)
const posterAlt = alt || (productPhoto && product ? product.name : 'Productos de decoración y regalos de la tienda')
---

<section class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
  <div class="relative h-[calc(100svh-6.25rem)] max-h-[54rem] min-h-[34rem] w-full lg:h-[calc(100svh-9.25rem)]">
    <img
      src={poster}
      srcset={productPhoto ? productImageSrcset(productPhoto, [800, 1200, 1800, 2400]) : undefined}
      sizes="100vw"
      alt={hasVideo ? '' : posterAlt}
      width="1800"
      height="1200"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 size-full animate-hero-zoom object-cover"
    />

    {hasVideo && (
      <video
        class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-1000"
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        aria-label={posterAlt}
        data-hero-video
      >
        {video.mobile && video.desktop && <source src={video.mobile} type={videoType(video.mobile)} media="(max-width: 767px)" />}
        <source src={desktopVideo} type={videoType(desktopVideo)} />
      </video>
    )}

    <!-- Velo para que el texto se lea sobre cualquier foto o video. -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/20 to-black/10" aria-hidden="true"></div>

    <div class="container-page relative flex h-full flex-col justify-end pb-12 sm:pb-16 lg:pb-20">
      <div class="max-w-3xl">
        <p class="eyebrow animate-rise !text-white/85">Decoración y regalos · {site.city}</p>
        <h1 id="hero-title" class="mt-4 animate-rise text-[3.25rem] leading-[0.95] [animation-delay:120ms] sm:text-[5rem] lg:text-[6.5rem]">
          Pequeños detalles que hacen <em>especial</em> cada espacio
        </h1>
        <p class="mt-6 max-w-md animate-rise text-base leading-relaxed text-white/85 [animation-delay:240ms] sm:text-lg">
          Descubre nuestra colección de decoración, regalos y artículos especiales.
        </p>
        <div class="mt-9 flex animate-rise flex-wrap gap-3 [animation-delay:360ms]">
          <a href="/catalogo" class:list={[buttonVariants({ variant: 'light', size: 'lg' }), 'group']}>
            Explorar colección
            <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={1.5} />
          </a>
          <a href="#novedades" class={buttonVariants({ variant: 'outline-light', size: 'lg' })}>Ver novedades</a>
        </div>
      </div>
    </div>

    {hasVideo ? (
      <button
        type="button"
        class="absolute right-5 bottom-5 z-10 grid size-11 place-items-center rounded-full border border-white/40 bg-black/25 text-white backdrop-blur-sm transition-colors hover:bg-black/45 sm:right-8 sm:bottom-8"
        aria-label="Reproducir video"
        data-hero-toggle
        data-playing="false"
      >
        <Pause class="pause-icon size-4" stroke-width={1.75} />
        <Play class="play-icon size-4" stroke-width={1.75} />
      </button>
    ) : productPhoto && product && (
      <a
        href={`/productos/${product.slug}`}
        class="group absolute top-6 right-5 z-10 hidden animate-rise items-center gap-3 rounded-full border border-white/30 bg-black/25 py-2 pr-2 pl-4 text-sm backdrop-blur-md transition-colors [animation-delay:600ms] hover:bg-black/45 md:flex lg:top-10 lg:right-12"
      >
        <span class="text-white/70">En la foto</span>
        <span class="max-w-52 truncate font-medium">{product.name}</span>
        <span class="text-white/70">{formatCurrency(product.price)}</span>
        <span class="grid size-8 place-items-center rounded-full bg-white text-ink transition-transform duration-300 group-hover:translate-x-0.5">
          <ArrowRight class="size-3.5" stroke-width={1.75} />
        </span>
      </a>
    )}
  </div>
</section>

<style>
  [data-hero-toggle][data-playing='false'] .pause-icon,
  [data-hero-toggle][data-playing='true'] .play-icon {
    display: none;
  }
</style>

<script>
  // El video arranca solo si el usuario no pidió reducir movimiento ni ahorrar datos.
  // Mientras tanto (o si no arranca) se ve la foto de portada.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]')
  if (video && toggle) {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches || connection?.saveData === true
    const play = () => {
      video.preload = 'auto'
      video.play().catch(() => {})
    }
    video.addEventListener('playing', () => {
      video.classList.replace('opacity-0', 'opacity-100')
      toggle.dataset.playing = 'true'
      toggle.setAttribute('aria-label', 'Pausar video')
    })
    video.addEventListener('pause', () => {
      toggle.dataset.playing = 'false'
      toggle.setAttribute('aria-label', 'Reproducir video')
    })
    toggle.addEventListener('click', () => (video.paused ? play() : video.pause()))
    if (!calm) play()
  }
</script>
