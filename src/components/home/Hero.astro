---
import { ArrowRight } from '@lucide/astro'
// PROVISIONAL: reemplazar por una fotografía real (p. ej. '@/assets/hero.jpg').
import heroImage from '@/assets/hero.svg'
---

<section class="container-page grid items-center gap-10 pt-8 pb-16 md:grid-cols-[1.05fr_1fr] md:gap-16 md:pt-14 md:pb-24">
  <div class="flex flex-col items-start gap-6">
    <p class="eyebrow">Decoración y regalos · Bogotá</p>
    <h1 class="text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-7xl">
      Pequeños detalles que hacen <em class="font-normal text-clay">especial</em> cada espacio
    </h1>
    <p class="max-w-md text-lg leading-relaxed text-stone">
      Descubre nuestra colección de decoración, regalos y artículos especiales.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a href="/catalogo" class="btn btn-primary group">
        Explorar catálogo
        <ArrowRight class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
      <a href="#envios" class="btn btn-outline">Envíos en Bogotá</a>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-md md:max-w-none">
    <div class="absolute -top-4 -right-4 hidden h-full w-full rounded-t-full rounded-b-[var(--radius-card)] border border-clay/40 md:block" aria-hidden="true"></div>
    <img
      src={heroImage.src}
      alt="Jarrones de cerámica y un ramo decorativo sobre una repisa"
      width="800"
      height="1000"
      fetchpriority="high"
      decoding="async"
      class="relative aspect-[4/5] w-full rounded-t-full rounded-b-[var(--radius-card)] bg-sand object-cover"
    />
  </div>
</section>
