---
import { Gift, MessageCircleHeart, Store, Truck } from '@lucide/astro'

const benefits = [
  { icon: Gift, title: 'Detalles con encanto', text: 'Piezas escogidas una a una para decorar y regalar.' },
  { icon: MessageCircleHeart, title: 'Atención directa', text: 'Te respondemos por WhatsApp y resolvemos tus dudas.' },
  { icon: Truck, title: 'Envíos en Bogotá', text: 'Llevamos tu pedido a domicilio en toda la ciudad.' },
  { icon: Store, title: 'Recoge en tienda', text: 'Pasa por tu pedido cuando te quede bien, sin costo.' },
]
---

<section class="container-page py-16 sm:py-24" aria-labelledby="beneficios-titulo">
  <h2 id="beneficios-titulo" class="sr-only">Por qué comprar con nosotros</h2>
  <ul class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
    {benefits.map(({ icon: Icon, title, text }, index) => (
      <li
        class="group flex flex-col gap-4 rounded-[var(--radius-card)] border border-linen bg-card p-5 transition-all duration-300 hover:-translate-y-1 hover:border-clay/40 hover:shadow-soft sm:p-7"
        data-reveal
        style={`--reveal-delay:${index * 70}ms`}
      >
        <span class="grid size-12 place-items-center rounded-full bg-clay-soft text-clay transition-colors duration-300 group-hover:bg-clay group-hover:text-white">
          <Icon class="size-5.5" stroke-width={1.5} />
        </span>
        <h3 class="font-display text-lg leading-tight sm:text-xl">{title}</h3>
        <p class="text-sm leading-relaxed text-stone">{text}</p>
      </li>
    ))}
  </ul>
</section>
