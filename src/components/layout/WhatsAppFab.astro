---
import SocialIcon from '@/components/common/SocialIcon.astro'
import { whatsappLink } from '@/lib/whatsapp'

interface Props {
  businessName: string
}
const href = whatsappLink(`Hola ${Astro.props.businessName}, vi su tienda virtual y quiero hacer una consulta.`)
---

{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escríbenos por WhatsApp"
    class="fixed right-4 bottom-4 z-30 grid size-14 place-items-center rounded-full bg-[#1f7a4d] text-white shadow-lg shadow-ink/20 transition-transform duration-200 hover:scale-105 sm:right-6 sm:bottom-6"
  >
    <SocialIcon name="whatsapp" class="size-7" />
  </a>
)}
