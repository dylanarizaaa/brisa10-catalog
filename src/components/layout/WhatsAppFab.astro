---
import SocialIcon from '@/components/common/SocialIcon.astro'
import { whatsappLink } from '@/lib/whatsapp'

interface Props {
  businessName: string
}
const href = whatsappLink(`Hola ${Astro.props.businessName}, vi su tienda virtual y quiero hacer una consulta.`)
---

{href && (
  <aside aria-label="Contacto rápido">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      class="group fixed right-4 bottom-4 z-30 flex h-14 items-center rounded-full bg-whatsapp text-white shadow-lift transition-transform duration-200 hover:scale-[1.03] sm:right-6 sm:bottom-6"
    >
      <span class="grid size-14 place-items-center">
        <SocialIcon name="whatsapp" class="size-7" />
      </span>
      <!-- En escritorio el botón se despliega con el texto al pasar el cursor. -->
      <span class="max-w-0 overflow-hidden text-sm font-medium whitespace-nowrap transition-[max-width,padding] duration-300 ease-[var(--ease-soft)] group-hover:max-w-40 group-hover:pr-5 group-focus-visible:max-w-40 group-focus-visible:pr-5" aria-hidden="true">
        ¿Te ayudamos?
      </span>
    </a>
  </aside>
)}
