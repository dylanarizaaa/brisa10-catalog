---
// PENDIENTE: reemplazar por el logotipo del negocio (un <img> o SVG dentro del enlace).
interface Props {
  name: string
  class?: string
}
const { name, class: className = '' } = Astro.props
---

<a href="/" class:list={['font-display text-2xl font-medium tracking-tight text-ink', className]} aria-label={`${name}, ir al inicio`}>
  {name}<span class="text-clay">.</span>
</a>
