---
import { Mail, MapPin, Phone } from '@lucide/astro'
import SocialIcon from '@/components/common/SocialIcon.astro'
import { navLinks, site } from '@/config/site'
import { whatsappLink } from '@/lib/whatsapp'
import type { Business } from '@/types/business'
import Logo from './Logo.astro'

interface Props {
  business: Business
}
const { business } = Astro.props
const whatsapp = whatsappLink(`Hola ${business.business_name}, quiero hacer una consulta.`)
const socials = [
  { name: 'instagram', label: 'Instagram', href: site.social.instagram },
  { name: 'tiktok', label: 'TikTok', href: site.social.tiktok },
  { name: 'facebook', label: 'Facebook', href: site.social.facebook },
  { name: 'whatsapp', label: 'WhatsApp', href: whatsapp ?? '' },
] as const
const heading = 'font-sans text-xs font-semibold tracking-[0.18em] text-cream/60 uppercase'
---

<footer id="contacto" class="grain mt-24 scroll-mt-20 overflow-hidden bg-ink text-cream">
  <div class="container-page grid gap-12 pt-16 pb-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.2fr]">
    <div class="flex flex-col gap-5">
      <Logo name={business.business_name} class="!text-3xl !text-cream" />
      <p class="max-w-xs leading-relaxed text-cream/70">{site.tagline}.</p>
      <ul class="mt-1 flex gap-2">
        {socials.filter((social) => social.href).map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.label} de ${business.business_name}`}
              class="grid size-11 place-items-center rounded-full border border-cream/25 transition-all duration-200 hover:-translate-y-0.5 hover:border-cream hover:bg-cream hover:text-ink"
            >
              <SocialIcon name={social.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Pie de página">
      <h2 class={heading}>Tienda</h2>
      <ul class="mt-4 flex flex-col gap-1">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="inline-flex min-h-9 items-center text-cream/85 transition-colors hover:text-cream">
              <span class="link-draw">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class={heading}>Contacto</h2>
      <ul class="mt-4 flex flex-col gap-3.5 text-cream/85">
        <li class="flex gap-3">
          <MapPin class="mt-1 size-4 shrink-0 text-clay-soft" />
          <span>{business.address ? `${business.address}, ${site.city}` : `${site.city}, Colombia`}</span>
        </li>
        {business.phone && (
          <li class="flex gap-3">
            <Phone class="mt-1 size-4 shrink-0 text-clay-soft" />
            <a href={`tel:${business.phone.replace(/[^\d+]/g, '')}`} class="link-draw">{business.phone}</a>
          </li>
        )}
        {business.email && (
          <li class="flex gap-3">
            <Mail class="mt-1 size-4 shrink-0 text-clay-soft" />
            <a href={`mailto:${business.email}`} class="link-draw break-all">{business.email}</a>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="container-page">
    <p class="border-t border-cream/15 py-5 text-xs text-cream/60">
      © {new Date().getFullYear()} {business.business_name}. Los pedidos se confirman por WhatsApp; este sitio no procesa pagos.
    </p>
  </div>

  <!-- Nombre del negocio en grande, como remate decorativo. -->
  <p aria-hidden="true" class="-mb-[0.22em] text-center font-display text-[24vw] leading-none font-medium tracking-tighter whitespace-nowrap text-cream/[0.06] select-none lg:text-[16rem]">
    {business.business_name}
  </p>
</footer>
