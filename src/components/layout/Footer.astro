---
import { Mail, MapPin, MessageCircle, Phone, Store, Truck, WalletCards } from '@lucide/astro'
import SocialIcon from '@/components/common/SocialIcon.astro'
import { site } from '@/config/site'
import { catalogUrl } from '@/lib/catalogUrl'
import { whatsappLink } from '@/lib/whatsapp'
import type { Business } from '@/types/business'
import type { Category } from '@/types/category'
import Logo from './Logo.astro'

interface Props {
  business: Business
  categories: Category[]
}
const { business, categories } = Astro.props
const whatsapp = whatsappLink(`Hola ${business.business_name}, quiero hacer una consulta.`)
const socials = [
  { name: 'instagram', label: 'Instagram', href: site.social.instagram },
  { name: 'tiktok', label: 'TikTok', href: site.social.tiktok },
  { name: 'facebook', label: 'Facebook', href: site.social.facebook },
  { name: 'whatsapp', label: 'WhatsApp', href: whatsapp ?? '' },
] as const
const services = [
  { icon: Truck, title: site.shipping.summary, text: 'Costo según tu ubicación' },
  { icon: MessageCircle, title: 'Pedido por WhatsApp', text: 'Te confirmamos todo por chat' },
  { icon: Store, title: 'Recoge en tienda', text: 'Sin costo adicional' },
  { icon: WalletCards, title: 'Pago al confirmar', text: 'Sin pagos en línea' },
]
const help = [
  { href: '/#como-comprar', label: 'Cómo comprar' },
  { href: '/#envios', label: 'Envíos y entregas' },
  { href: '/carrito', label: 'Tu carrito' },
]
const heading = 'font-sans text-[0.6875rem] font-semibold tracking-[0.2em] text-ink uppercase'
const link = 'link-draw text-stone transition-colors duration-300 hover:text-ink'
---

<!-- Servicios de la tienda: se repiten en todas las páginas, justo antes del pie. -->
<section aria-labelledby="servicios-titulo" class="mt-24 border-y border-linen sm:mt-32">
  <h2 id="servicios-titulo" class="sr-only">Servicios de la tienda</h2>
  <ul class="container-page grid grid-cols-2 lg:grid-cols-4">
    {services.map(({ icon: Icon, title, text }, index) => (
      <li class:list={['flex flex-col items-center gap-3 px-3 py-9 text-center sm:py-11', index % 2 === 1 && 'border-l border-linen', index > 1 && 'border-t border-linen lg:border-t-0', index === 2 && 'lg:border-l']}>
        <Icon class="size-6 text-ink" stroke-width={1.25} />
        <div>
          <h3 class="font-sans text-[0.8125rem] font-semibold tracking-[0.04em]">{title}</h3>
          <p class="mt-1 text-[0.8125rem] text-stone">{text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<footer id="contacto" class="relative overflow-hidden bg-cream text-ink">
  <div class="container-page grid gap-12 pt-16 pb-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr] lg:gap-10 lg:pt-20">
    <div class="flex flex-col gap-5">
      <Logo name={business.business_name} />
      <p class="max-w-xs leading-relaxed text-stone">{site.tagline}.</p>
      <ul class="mt-1 flex gap-2">
        {socials.filter((social) => social.href).map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.label} de ${business.business_name}`}
              class="grid size-11 place-items-center rounded-full border border-ink/15 bg-paper transition-all duration-300 hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-white"
            >
              <SocialIcon name={social.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Tienda">
      <h2 class={heading}>Tienda</h2>
      <ul class="mt-5 flex flex-col gap-2.5 text-[0.9375rem]">
        <li><a href="/catalogo" class={link}>Todo el catálogo</a></li>
        {categories.slice(0, 6).map((category) => (
          <li><a href={catalogUrl({ categoria: category.slug })} class={link}>{category.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Ayuda">
      <h2 class={heading}>Ayuda</h2>
      <ul class="mt-5 flex flex-col gap-2.5 text-[0.9375rem]">
        {help.map((item) => (
          <li><a href={item.href} class={link}>{item.label}</a></li>
        ))}
        {whatsapp && (
          <li><a href={whatsapp} target="_blank" rel="noopener noreferrer" class={link}>Escríbenos por WhatsApp</a></li>
        )}
      </ul>
    </nav>

    <div>
      <h2 class={heading}>Contacto</h2>
      <ul class="mt-5 flex flex-col gap-3.5 text-[0.9375rem] text-stone">
        <li class="flex gap-3">
          <MapPin class="mt-1 size-4 shrink-0 text-ink" stroke-width={1.5} />
          <span>{business.address ? `${business.address}, ${site.city}` : `${site.city}, Colombia`}</span>
        </li>
        {business.phone && (
          <li class="flex gap-3">
            <Phone class="mt-1 size-4 shrink-0 text-ink" stroke-width={1.5} />
            <a href={`tel:${business.phone.replace(/[^\d+]/g, '')}`} class={link}>{business.phone}</a>
          </li>
        )}
        {business.email && (
          <li class="flex gap-3">
            <Mail class="mt-1 size-4 shrink-0 text-ink" stroke-width={1.5} />
            <a href={`mailto:${business.email}`} class:list={[link, 'break-all']}>{business.email}</a>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="container-page">
    <div class="flex flex-col gap-2 border-t border-linen py-6 text-xs text-stone sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {business.business_name}. Todos los derechos reservados.</p>
      <p>Los pedidos se confirman por WhatsApp; este sitio no procesa pagos.</p>
    </div>
  </div>

  <!-- Nombre del negocio en grande, como remate editorial (decorativo: va en CSS, no es texto). -->
  <div
    aria-hidden="true"
    data-wordmark={business.business_name}
    class="-mb-[0.2em] text-center font-display text-[25vw] leading-none whitespace-nowrap text-ink/[0.045] select-none before:content-[attr(data-wordmark)] lg:text-[17rem]"
  ></div>
</footer>
