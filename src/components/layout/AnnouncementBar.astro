---
import { site } from '@/config/site'

// En el celular cabe un mensaje; en pantallas anchas se muestran los tres.
const messages = [site.shipping.summary, 'Haz tu pedido por WhatsApp', 'Recoge en tienda sin costo']
---

<aside aria-label="Avisos de la tienda" class="bg-ink text-white">
  <ul class="container-page flex h-9 items-center justify-center gap-10 text-[0.75rem] tracking-[0.06em]">
    {messages.map((message, index) => (
      <li class:list={[index > 0 && 'hidden md:block']}>{message}</li>
    ))}
  </ul>
</aside>
