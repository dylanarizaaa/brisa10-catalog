---
import { Menu, Search, ShoppingBag, X } from '@lucide/astro'
import { navLinks } from '@/config/site'
import Logo from './Logo.astro'

interface Props {
  businessName: string
}
const { businessName } = Astro.props
const path = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href))
---

<header class="sticky top-0 z-40 border-b border-linen/70 bg-cream/85 backdrop-blur-lg">
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <div class="flex items-center gap-2">
      <button
        type="button"
        popovertarget="mobile-menu"
        class="-ml-2 grid size-11 place-items-center rounded-full transition-colors hover:bg-sand md:hidden"
        aria-label="Abrir menú"
      >
        <Menu class="size-5" />
      </button>
      <Logo name={businessName} />
    </div>

    <nav class="hidden md:block" aria-label="Principal">
      <ul class="flex items-center gap-8 text-[0.9375rem]">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="nav-link relative py-2 text-stone transition-colors hover:text-ink aria-[current=page]:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="-mr-2 flex items-center">
      <a href="/catalogo" class="grid size-11 place-items-center rounded-full transition-colors hover:bg-sand" aria-label="Buscar en el catálogo">
        <Search class="size-5" />
      </a>
      <a href="/carrito" class="relative grid size-11 place-items-center rounded-full transition-colors hover:bg-sand" aria-label="Ver carrito" data-cart-link>
        <ShoppingBag class="size-5" />
        <span
          data-cart-count
          hidden
          aria-hidden="true"
          class="absolute top-1 right-0.5 grid h-[1.125rem] min-w-[1.125rem] place-items-center rounded-full bg-clay px-1 text-[0.6875rem] leading-none font-semibold text-white"
        ></span>
      </a>
    </div>
  </div>
</header>

<!-- Menú móvil: API popover nativa, sin JavaScript. -->
<div id="mobile-menu" popover role="dialog" aria-label="Menú" class="mobile-menu m-0 h-dvh max-h-none w-[min(20rem,85vw)] max-w-none flex-col bg-cream p-0 text-ink shadow-2xl md:hidden">
  <div class="flex h-16 items-center justify-between border-b border-linen px-5">
    <Logo name={businessName} />
    <button
      type="button"
      popovertarget="mobile-menu"
      popovertargetaction="hide"
      class="-mr-2 grid size-11 place-items-center rounded-full transition-colors hover:bg-sand"
      aria-label="Cerrar menú"
    >
      <X class="size-5" />
    </button>
  </div>
  <nav aria-label="Menú móvil" class="flex-1 overflow-y-auto px-5 py-4">
    <ul class="flex flex-col">
      {navLinks.map((link) => (
        <li class="border-b border-linen/60">
          <a href={link.href} class="flex min-h-14 items-center font-display text-xl">{link.label}</a>
        </li>
      ))}
      <li>
        <a href="/carrito" class="flex min-h-14 items-center font-display text-xl">Carrito</a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-clay);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease-soft);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .mobile-menu:popover-open {
    display: flex;
    inset: 0 auto 0 0;
    animation: slide-in 260ms var(--ease-soft);
  }
  .mobile-menu::backdrop {
    background: rgb(43 38 34 / 0.45);
  }
  @keyframes slide-in {
    from {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  // Al tocar un enlace del menú (p. ej. un ancla de la misma página) se cierra el panel.
  import { cartCount, onCartChange } from '@/lib/cart'

  // Contador del carrito: vive en localStorage, así que se pinta en el navegador.
  const link = document.querySelector<HTMLElement>('[data-cart-link]')
  const badge = document.querySelector<HTMLElement>('[data-cart-count]')
  function renderCartCount() {
    if (!link || !badge) return
    const count = cartCount()
    const text = count > 99 ? '99+' : String(count)
    // Pequeño rebote cuando cambia la cantidad (no al cargar la página).
    if (badge.textContent && badge.textContent !== text && count > 0) {
      badge.classList.remove('animate-pop')
      void badge.offsetWidth
      badge.classList.add('animate-pop')
    }
    badge.hidden = count === 0
    badge.textContent = text
    link.setAttribute('aria-label', count === 0 ? 'Ver carrito' : `Ver carrito (${count} ${count === 1 ? 'producto' : 'productos'})`)
  }
  renderCartCount()
  onCartChange(renderCartCount)

  const menu = document.getElementById('mobile-menu')
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.hidePopover()
  })
</script>
